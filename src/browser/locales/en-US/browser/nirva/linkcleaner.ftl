## Automatic Link Cleaner, shown in the Privacy Receipt panel.

nirva-linkclean-label = Link cleaning
# $names (String) - Comma-separated names of the removed tracking parts, such as "utm_source, fbclid".
nirva-linkclean-removed = Removed from the link that opened this page: { $names }.
# $names (String) - Comma-separated names of the first removed tracking parts.
# $more (Number) - How many further parts were removed.
nirva-linkclean-removed-more = Removed from the link that opened this page: { $names } and { $more } more.
nirva-linkclean-clean = Tracking parts are removed from links that lead here from other sites.
nirva-linkclean-exempt = Links to this site open exactly as written.
nirva-linkclean-site = Clean links to this site
nirva-linkclean-on = On
nirva-linkclean-off = Off
nirva-linkclean-original = Load the original link
