# The name Firefox shows for the temporary container behind a burner tab.
nirva-burner-container-name = Burner
nirva-burner-context-link =
    .label = Open Link in Burner Tab
nirva-burner-title = Burner tab
nirva-burner-eyebrow = Temporary
nirva-burner-intro = This tab keeps its own cookies and site data, apart from your other tabs. When you close it, that data is erased. Type an address above to begin. Links you open from here stay in the same burner until its last tab is closed.
nirva-burner-intro-outside = A burner tab keeps its own cookies and site data, apart from your other tabs. When you close it, that data is erased. Links opened from a burner tab stay in the same burner until its last tab is closed.
nirva-burner-open = Open a burner tab
# The marker in the address bar while a burner tab is in front.
nirva-burner-chip =
    .title = This is a burner tab. Its cookies and site data are erased when it closes. Select to see what is and is not erased.
nirva-burner-chip-label = Burner
nirva-burner-limits-title = What a burner tab is not
nirva-burner-limits-copy = A burner tab does not make you anonymous. Websites still see your internet address and anything you type or sign in to. Your internet provider, school or workplace network can still see which sites you visit. It does not protect against malware or against anyone who can watch this device.
nirva-burner-erased-title = Erased when the burner closes
nirva-burner-erased-cookies = Cookies set while you browsed in it
nirva-burner-erased-storage = Site storage, such as saved sign-ins and offline data
nirva-burner-erased-cache = Files the sites stored for this burner
nirva-burner-erased-session = Its place in “reopen closed tab” and in the restored session
nirva-burner-kept-title = Not erased
nirva-burner-kept-downloads = Files you download
nirva-burner-kept-bookmarks = Bookmarks you add
nirva-burner-kept-passwords = Passwords you choose to save
nirva-burner-kept-permissions = Permissions you give a site, such as camera or location
nirva-burner-never-title = Never recorded from a burner tab
nirva-burner-never-history = Pages you visit are not added to your browsing history.
nirva-burner-never-nirva = { -brand-short-name } does not index its pages for search, save them to the Library, clip them, remix them, or include them in Time Travel.
