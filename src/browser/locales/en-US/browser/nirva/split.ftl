## Split view: two to four tabs shown together.

nirva-split-tab-button =
    .title = Split view with this tab
    .aria-label = Split view with this tab
nirva-split-island-button =
    .title = Split view
    .aria-label = Split view
nirva-split-eyebrow = Split view
# $count (Number) - How many tabs are ticked, up to 4.
nirva-split-tally = { $count } of 4
nirva-split-list =
    .aria-label = Tabs to show together
nirva-split-layout = Layout
# $place (Number) - The place the tab has now; the button moves it one place earlier.
nirva-split-move-up =
    .title = Move to place { $place }
    .aria-label = Move to place { $place }
nirva-split-open = Open split view
nirva-split-apply = Apply
nirva-split-cancel = Cancel
nirva-split-done = Done
nirva-split-even = Even sizes
nirva-split-separate = Separate
nirva-split-context =
    .label = Split view…
    .accesskey = S
nirva-split-context-arrange =
    .label = Arrange split view…
    .accesskey = S
nirva-split-open-link =
    .label = Open link in split view
    .accesskey = v
nirva-split-divider =
    .aria-label = Resize the pages on each side
nirva-split-cross =
    .aria-label = Resize all four pages

## Layout choices

nirva-split-shape-cols =
    .title = Side by side
    .aria-label = Side by side
nirva-split-shape-rows =
    .title = One above the other
    .aria-label = One above the other
nirva-split-shape-main-left =
    .title = One large page on the left
    .aria-label = One large page on the left
nirva-split-shape-main-top =
    .title = One large page on top
    .aria-label = One large page on top
nirva-split-shape-grid =
    .title = Grid of four
    .aria-label = Grid of four
